# Copy outside the checkout, chmod 600, and use threadwatch --env-file PATH collect.
# The same native binary runs on collector-only hosts; no frontend build is needed.
TW_SERVER_URL=http://192.168.1.115:8787
TW_INGEST_TOKEN_FILE=/etc/threadwatch/ingest-token
# JSON array containing exactly ONE bridge with a unique id and display name.
TW_BRIDGES_FILE=/etc/threadwatch/bridge.json
TW_COLLECTOR_DATA_DIR=/var/lib/threadwatch-collector
TW_COLLECT_INTERVAL_MS=2000
TW_HEARTBEAT_INTERVAL_MS=10000
