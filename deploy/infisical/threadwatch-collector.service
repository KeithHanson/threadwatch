[Unit]
Description=Threadwatch collector
Wants=network-online.target docker.service
After=network-online.target docker.service zerotier-one.service

[Service]
Type=simple
User=services
WorkingDirectory=/home/services/.config/threadwatch
RuntimeDirectory=threadwatch-collector
RuntimeDirectoryMode=0700
LoadCredential=client-id:/etc/threadwatch/credentials/server-client-id
LoadCredential=client-secret:/etc/threadwatch/credentials/server-client-secret
Environment=INFISICAL_DISABLE_UPDATE_CHECK=true
Environment=DO_NOT_TRACK=1
ExecStartPre=/usr/local/bin/infisical agent --config=/etc/threadwatch/collector-agent.yaml
ExecStartPre=/usr/bin/chmod 0600 /run/threadwatch-collector/collector.env /run/threadwatch-collector/ingest-token
ExecStart=/usr/local/bin/threadwatch --env-file /run/threadwatch-collector/collector.env collect
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
