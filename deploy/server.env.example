# Copy outside the checkout, chmod 600, and adjust paths for the service user.
# Trusted LAN viewing; chat additionally requires the separate control token.
TW_LOCAL=1
TW_LAN=1
TW_HOST=192.168.10.5
# Optional comma-separated public reverse-proxy hostnames.
TW_ALLOWED_HOSTS=
TW_PORT=8787
TW_INGEST_TOKEN_FILE=/etc/threadwatch/ingest-token
TW_CONTROL_TOKEN_FILE=/etc/threadwatch/control-token
TW_DATA_DIR=/var/lib/threadwatch
# Optional: withhold tool details for calls touching credential/instruction files. Disabled by default.
TW_WITHHELD_TOOL_DETAILS=0
