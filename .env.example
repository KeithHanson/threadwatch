# Load explicitly: node --env-file=.env server/index.mjs
# Local mode: loopback only, no Discord identity required. NEVER tunnel this mode.
TW_LOCAL=1
TW_HOST=127.0.0.1
TW_PORT=8787
TW_DATA_DIR=.data
TW_BRIDGES_FILE=./bridges.local.json

# Discord mode: set TW_LOCAL=0 and fill these on the SERVER only.
TW_DISCORD_CLIENT_ID=
TW_DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs. Each user can read ALL configured sources.
TW_ALLOWED_USER_IDS=
# Optional shared secret for trusted runner ingestion; omit both to disable ingestion.
# Set ONE of TW_INGEST_TOKEN (at least 32 characters) or TW_INGEST_TOKEN_FILE.
# TW_INGEST_TOKEN_FILE=/absolute/path/to/mode-600-ingest-token
