# Load explicitly: threadwatch --env-file .env serve
# Loopback-only viewer mode. For trusted LAN, set TW_LAN=1 and a private TW_HOST.
TW_LOCAL=1
TW_HOST=127.0.0.1
TW_PORT=8787
TW_DATA_DIR=.data
# Optional shared ingestion credential; omit both to disable producer writes.
# Set ONE of TW_INGEST_TOKEN (at least 32 characters) or TW_INGEST_TOKEN_FILE.
# TW_INGEST_TOKEN_FILE=/absolute/path/to/private-ingest-token
